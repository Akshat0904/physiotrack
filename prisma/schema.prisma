generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Visit {
  id          String      @id @default(cuid())
  patientName String
  address     String
  latitude    Float?
  longitude   Float?

  visitDate   DateTime
  startTime   String      // "09:00" format
  duration    Int         // minutes
  chargeAmount Float      // INR

  orderIndex  Int         @default(0)
  notes       String?
  status      VisitStatus @default(SCHEDULED)

  travelTimeFromPrev     Int?    // minutes, auto or manual
  travelTimeMode         String? // "auto" | "manual"
  travelDistanceFromPrev Float?  // km

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}
