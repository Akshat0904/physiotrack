generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (e.g. Supabase's pgbouncer pooler on :6543) used at
  // runtime by the app. Must include `pgbouncer=true` — without it, pooled
  // transaction-mode connections get reused across requests/lambdas and
  // Prisma's named prepared statements collide ("prepared statement ...
  // already exists", Postgres error 42P05).
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection used only for `prisma migrate` / `db push`,
  // since DDL and advisory locks don't work reliably through a transaction
  // pooler.
  directUrl = env("DIRECT_URL")
}

model Patient {
  id        String   @id @default(cuid())
  name      String
  address   String
  latitude  Float?
  longitude Float?
  phone     String?
  notes     String?
  visits    Visit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Visit {
  id          String      @id @default(cuid())
  patientId   String
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  visitDate   DateTime
  startTime   String      // "09:00" format
  duration    Int         // minutes
  chargeAmount Float      // INR

  orderIndex  Int         @default(0)
  notes       String?
  status      VisitStatus @default(SCHEDULED)

  travelTimeFromPrev     Int?    // minutes, auto or manual
  travelTimeMode         String? // "auto" | "manual"
  travelDistanceFromPrev Float?  // km

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}
